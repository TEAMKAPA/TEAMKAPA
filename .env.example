# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium ani do obrazów.

# --- Pliki wejściowe ---
MAX_FILE_SIZE_MB=20

# --- Uwierzytelnianie JWT (API tylko weryfikuje tokeny) ---
JWT_ENABLED=true
# Min. 32 znaki. Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-runtime
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_LEEWAY_SECONDS=30

# --- Endpointy analizy ---
# analyze czeka na wynik tyle sekund, potem zwraca 202 z job_id (wynik: GET /api/v1/jobs/{id})
ANALYZE_WAIT_SECONDS=60
ANALYZE_MAX_WAIT_SECONDS=300
MAX_BATCH_FILES=20

# --- PostgreSQL (DATABASE_URL składa z tych wartości docker-compose) ---
POSTGRES_USER=coi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coi_forms
DB_POOL_MAX_SIZE=5

# --- Kolejka ---
VALKEY_URL=redis://valkey:6379/0
JOB_QUEUE_TTL_SECONDS=3600
JOB_RESULT_TTL_SECONDS=3600
JOB_TIMEOUT_SECONDS=1800
WORKER_MAX_JOBS=1
# Ponowienia po błędach przejściowych i awariach workera (łączna liczba prób)
MAX_JOB_TRIES=3
RETRY_BACKOFF_SECONDS=30
# Retencja zadań i wygenerowanych wyników (zatwierdzone formularze zostają)
RESULT_RETENTION_DAYS=30
STALE_JOB_GRACE_SECONDS=120

# --- LLM (Eden AI API) ---
# Klucz API z panelu Eden AI (wymagany, gdy LLM_DEMO_MODE=false)
EDENAI_API_KEY=
EDENAI_BASE_URL=https://api.edenai.run/v3
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=300
# Tryb demonstracyjny bez modelu (wynik oznaczony w raporcie, pewność LOW, nie do importu)
LLM_DEMO_MODE=false

# --- VLM ---
VLM_BASE_URL=http://vlm:8001/v1
VLM_MODEL=change-me-vlm-model
VLM_GPU_MEMORY_UTILIZATION=0.45
# Tylko jeśli model na Hugging Face wymaga akceptacji licencji
HF_TOKEN=

# --- Przetwarzanie ---
ACCURACY_MODE=max
RENDER_DPI=200
# Progi pewności pól: >= HIGH zielone, >= LOW żółte, poniżej czerwone
CONFIDENCE_HIGH=0.85
CONFIDENCE_LOW=0.5

# --- Porty na hoście ---
API_PORT=8000
FRONTEND_PORT=8080
