# Label Studio 1.23.2 (Community, Apache-2.0): ustawienia serwera dla oznaczania zbioru #12.
# Użycie: docker run --env-file eval/visual/labelstudio/ls.env ... (pełna komenda w eval/visual/README.md).
# Plik nie zawiera sekretów.
#
# Podstawa: źródła tagu 1.23.2 repozytorium HumanSignal/label-studio.
# - label_studio/core/utils/params.py, get_env: najpierw LABEL_STUDIO_<NAZWA>, potem HEARTEX_<NAZWA>
#   i <NAZWA>; pusta wartość jest używana dosłownie (nie zastępuje jej wartość domyślna).
# - label_studio/core/settings/label_studio.py: w wersji Community SENTRY_DSN i FRONTEND_SENTRY_DSN
#   mają domyślnie adresy *.ingest.sentry.io, czyli raportowanie błędów jest WŁĄCZONE.
# - label_studio/core/utils/sentry.py (init_sentry) i templates/base.html: pusty DSN wyłącza Sentry
#   po stronie serwera i przeglądarki (skrypt browser.sentry-cdn.com nie jest wtedy dołączany).
# - label_studio/core/settings/base.py: COLLECT_ANALYTICS (domyślnie true), LATEST_VERSION_CHECK
#   (domyślnie true, zapytanie do PyPI), LOCAL_FILES_*; settings/label_studio.py: FEATURE_FLAGS_OFFLINE.
# - users/templates/users/user_base.html i new-ui/user_base.html: przy COLLECT_ANALYTICS=true strony
#   logowania ładują Google Tag Manager i ramkę labelstud.io/track.
# - core/views.py, heidi_tips: serwer pobiera wskazówki z raw.githubusercontent.com bez możliwości
#   wyłączenia flagą; blokuje to nieistniejący serwer proxy niżej.

# Obrazy stron (tylko odczyt) serwowane z /label-studio/files/pages.
LABEL_STUDIO_LOCAL_FILES_SERVING_ENABLED=true
LABEL_STUDIO_LOCAL_FILES_DOCUMENT_ROOT=/label-studio/files

# Raportowanie błędów (Sentry) serwera i przeglądarki: wyłączone pustym DSN.
LABEL_STUDIO_SENTRY_DSN=
LABEL_STUDIO_FRONTEND_SENTRY_DSN=

# Telemetria (Google Tag Manager, labelstud.io/track, zdarzenia __lsa): wyłączona.
LABEL_STUDIO_COLLECT_ANALYTICS=false

# Sprawdzanie najnowszej wersji w PyPI: wyłączone.
LABEL_STUDIO_LATEST_VERSION_CHECK=false

# Flagi funkcji tylko lokalnie.
LABEL_STUDIO_FEATURE_FLAGS_OFFLINE=true

# Blokada ruchu wychodzącego HTTP(S) procesu serwera: każde połączenie poza localhost trafia
# do nieistniejącego proxy i kończy się błędem.
HTTP_PROXY=http://127.0.0.1:9
HTTPS_PROXY=http://127.0.0.1:9
http_proxy=http://127.0.0.1:9
https_proxy=http://127.0.0.1:9
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1
