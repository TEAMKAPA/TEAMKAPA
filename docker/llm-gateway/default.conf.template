# Bramka do Eden AI — jedyne wyjście sieciowe przetwarzania (worker nie ma internetu).
# Przepuszcza wyłącznie GET /v3/models i POST /v3/chat/completions do api.edenai.run,
# weryfikuje certyfikat TLS i dokłada klucz API (worker go nie zna).
# ${EDENAI_API_KEY} podstawia entrypoint obrazu nginx (envsubst, NGINX_ENVSUBST_FILTER=EDENAI_);
# wygenerowana konfiguracja leży w tmpfs, nie w obrazie.

resolver 127.0.0.11 valid=300s ipv6=off;
resolver_timeout 10s;

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 50m;  # obrazy stron dla modelu wizyjnego (#11)

    set $edenai https://api.edenai.run;

    proxy_http_version 1.1;
    proxy_set_header Host api.edenai.run;
    proxy_set_header Connection "";
    proxy_set_header Authorization "Bearer ${EDENAI_API_KEY}";
    proxy_set_header X-Forwarded-For "";
    proxy_ssl_server_name on;
    proxy_ssl_name api.edenai.run;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 4;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_connect_timeout 15s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /v3/chat/completions {
        limit_except POST { deny all; }
        proxy_pass $edenai/v3/chat/completions;
    }

    # Katalog modeli jest publiczny — bez klucza (sprawdzenie otwartych wag nie zależy od klucza).
    # proxy_set_header w lokacji zastępuje wszystkie dziedziczone nagłówki, stąd powtórzenia.
    location = /v3/models {
        limit_except GET { deny all; }
        proxy_set_header Host api.edenai.run;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Authorization "";
        proxy_pass $edenai/v3/models;
    }

    location / {
        return 404;
    }
}
